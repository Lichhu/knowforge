NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://knowforge:knowforge@localhost:5432/knowforge
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL=8h
COOKIE_SECURE=false

# Optional first-run bootstrap. Set both once to create an administrator.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# OpenAI-compatible model endpoint. Keep API keys outside source control.
# OpenCode Go Chat Completions: https://opencode.ai/inference/go/openai/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000
